# Copy this file to ".env" and fill in your real values.
# NEVER upload the real .env file to GitHub.

# --- AI provider ---
# "groq"  = FREE, no credit card needed (DEFAULT - recommended for you)
# "openai" = paid upgrade, works with the exact same code
AI_PROVIDER=groq

# --- Groq (FREE) - get your key at https://console.groq.com -> API Keys ---
GROQ_API_KEY=gsk_your-groq-key-here

# --- OpenAI (OPTIONAL, only if AI_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-your-openai-key-here

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# --- CORS: who is allowed to call this API (your Vercel website + local dev) ---
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- Optional knobs (defaults are fine) ---
MAX_UPLOAD_MB=512
RECAP_ENABLED=false
