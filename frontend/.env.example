# Copy this file to ".env.local" and fill in your real values.
# These start with NEXT_PUBLIC_ so the browser is allowed to see them (that's safe for Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# The web address of your backend on Render (no slash at the end!)
NEXT_PUBLIC_API_URL=http://localhost:8000
